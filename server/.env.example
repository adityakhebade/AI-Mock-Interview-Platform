# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# CORS — must align with CLERK_AUTHORIZED_PARTIES frontend origins
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/intervuex?schema=public

# Clerk (reuse the same Clerk application as the Next.js frontend)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional only when using networkless JWT verification:
# CLERK_JWT_KEY=
