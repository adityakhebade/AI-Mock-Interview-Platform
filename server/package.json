{
  "name": "intervuex-backend",
  "version": "1.0.0",
  "description": "IntervueX Backend API - Express.js REST API for AI Mock Interview Platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "express",
    "typescript",
    "rest-api",
    "interview-platform"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "cookie-parser": "^1.4.7",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.10",
    "@types/cookie-parser": "^1.4.7",
    "@types/compression": "^1.7.5",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2"
  }
}
